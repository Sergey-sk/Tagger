<UserControl x:Class="Tagger.view.LeftSideBar.TopElements"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tagger.view.LeftSideBar"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style TargetType="ListBoxItem" x:Key="BaseListBoxItem">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <!--QuickAccess-->
        <Style TargetType="ListBoxItem" x:Key="QuickAccess" BasedOn="{StaticResource BaseListBoxItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4">
                            <Grid>
                                <Border x:Name="QuickAccessHoverLayer"
                                        Background="{DynamicResource BorderBackgroundHoverBrush}"
                                        BorderBrush="{DynamicResource BorderBorderBrushHoverBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="-8,0"
                                        Opacity="0"
                                        Panel.ZIndex="0"/>

                                <ContentPresenter Panel.ZIndex="1"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="QuickAccessHoverLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="QuickAccessHoverLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                                
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BorderBackgroundSelectedBrush}"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource BorderBorderBrushSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="QuickAccessData">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Text="&#xE915;"
               FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <!--QuickAccess-->

        <!--SavedSearch-->
        <ControlTemplate x:Key="RemoveSearchButton" TargetType="Button">
            <Border Name="pinBorder" Padding="5" Margin="5,0" Background="Transparent" CornerRadius="4">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="contentTranslate"
                                         Storyboard.TargetProperty="Y"
                                         To="1.0" Duration="0:0:0.15"/>

                                <DoubleAnimation Storyboard.TargetName="contentScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1.0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="contentScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1.0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </VisualState>

                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="contentScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         To="1.15" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="contentScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         To="1.15" Duration="0:0:0.15"/>
                            </Storyboard>
                        </VisualState>

                        <VisualState x:Name="Disabled"/>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <ContentPresenter x:Name="content"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          TextBlock.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          RenderTransformOrigin="0.5,0.5">
                    <ContentPresenter.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="contentScale" ScaleX="1.0" ScaleY="1.0"/>
                            <TranslateTransform x:Name="contentTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </ContentPresenter.RenderTransform>
                </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="content" Property="TextBlock.Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        
        <Style TargetType="ListBoxItem" x:Key="SearchListItem" BasedOn="{StaticResource BaseListBoxItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="4">

                            <Grid>
                                <Border x:Name="SearchHoverLayer"
                                        Background="{DynamicResource BorderBackgroundHoverBrush}"
                                        BorderBrush="{DynamicResource BorderBorderBrushHoverBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="-8,0"
                                        Opacity="0"
                                        Panel.ZIndex="0"/>
                                <Grid Panel.ZIndex="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"/>

                                    <Button Grid.Column="1"
                                            x:Name="removeButton"
                                            Content="&#xE74D;"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Template="{StaticResource RemoveSearchButton}"
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            Command="{Binding DataContext.Workspace.RemoveSavedSearchCommand, 
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Opacity="0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SearchHoverLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="removeButton"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SearchHoverLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="removeButton"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BorderBackgroundSelectedBrush}"/>
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource BorderBorderBrushSelectedBrush}"/>
                                <Setter TargetName="removeButton" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SavedSearchData">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Text="&#xE915;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"/>
                <TextBlock Text="{Binding QueryText}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <!--SavedSearch-->
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="16" VerticalAlignment="Center" Padding="10,3">
            <Run Text="&#xE838;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12"/>
            <Run Text="Быстрый доступ" FontSize="14" FontWeight="SemiBold"/>
        </TextBlock>

        <ListBox Grid.Row="1"
             Background="Transparent"
             ItemsSource="{Binding Workspace.QuickAccess}"
             SelectedItem="{Binding Workspace.SelectedQuickAccessPath}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             ItemContainerStyle="{StaticResource QuickAccess}"
             ItemTemplate="{StaticResource QuickAccessData}"/>

        <TextBlock Grid.Row="2" FontSize="16" VerticalAlignment="Center" Padding="10,3">
            <Run Text="&#xE840;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12"/>
            <Run Text="Сохраненный поиск" FontSize="14" FontWeight="SemiBold"/>
        </TextBlock>

        <ListBox Grid.Row="3"
             Background="Transparent"
             ItemsSource="{Binding Workspace.SavedSearch}"
             SelectedItem="{Binding Workspace.SelectedSavedSearch}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             ItemContainerStyle="{StaticResource SearchListItem}"
             ItemTemplate="{StaticResource SavedSearchData}"/>
    </Grid>
</UserControl>

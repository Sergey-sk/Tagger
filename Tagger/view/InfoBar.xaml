<UserControl x:Class="Tagger.view.InfoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tagger.view"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="boolToVis"/>

        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource InfoBarBackgroundButtonBrush}"/>
                                <Setter TargetName="border" Property="TextBlock.Foreground" Value="{DynamicResource InfoBarTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid x:Name="InfoBarGrid"
          HorizontalAlignment="Right"
          VerticalAlignment="Bottom"
          Margin="16,16,10,54"
          Panel.ZIndex="100"
          Visibility="{Binding InfoBar.IsInfoBarOpen, Converter={StaticResource boolToVis}}">

        <Border Background="Black"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.35"
                                  Color="Black"/>
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource InfoBarBackgroundBrush}"
                BorderBrush="{DynamicResource InfoBarBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                        Grid.Row="0">

                    <TextBlock Text="&#xEA1F;"
                               FontFamily="{StaticResource SymbolThemeFontFamily}"
                               FontSize="16"
                               Foreground="{DynamicResource InfoBarIconBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding InfoBar.Title}"
                               Foreground="{DynamicResource InfoBarTextBrush}"
                               VerticalAlignment="Center"
                               Margin="10"/>

                    <Button Content="&#xE711;"
                            Style="{StaticResource ActionButtonStyle}"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Foreground="{DynamicResource InfoBarCloseBrush}"
                            Padding="5,3"
                            Command="{Binding InfoBar.CloseInfoBarCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="Обновить"
                            Style="{StaticResource ActionButtonStyle}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource InfoBarTextBrush}"
                            Padding="10,5"
                            Command="{Binding InfoBar.UpdateFileChangesCommand}"/>

                    <Button Content="Отмена"
                            Style="{StaticResource ActionButtonStyle}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource InfoBarCloseBrush}"
                            Padding="10,5"
                            Command="{Binding InfoBar.CloseInfoBarCommand}"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>

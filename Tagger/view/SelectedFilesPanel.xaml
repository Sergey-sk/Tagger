<UserControl x:Class="Tagger.view.SelectedFilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Tagger.view"
             xmlns:conv="clr-namespace:Tagger"
             xmlns:convsize="clr-namespace:Tagger.viewmodel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <conv:WidthConverter x:Key="WidthConverter"/>
        <convsize:SizeConverter x:Key="SizeConverter"/>

        <ControlTemplate x:Key="HidePanelButton" TargetType="Button">
            <Border Background="Transparent" CornerRadius="4">
                <ContentPresenter x:Name="content"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Opacity="0.7">
                    <ContentPresenter.RenderTransform>
                        <TranslateTransform x:Name="contentTranslate" X="0"/>
                    </ContentPresenter.RenderTransform>
                </ContentPresenter>
            </Border>

            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="content"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="3" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CircleEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>

                                <DoubleAnimation Storyboard.TargetName="content"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="content"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 To="0" Duration="0:0:0.15"/>

                                <DoubleAnimation Storyboard.TargetName="content"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.7" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <Border x:Name="SlidingPanel"
            BorderBrush="{DynamicResource RightTagPanelBorderBrush}"
            Background="{DynamicResource RightTagPanelBackgroundBrush}"
            CornerRadius="4"
            BorderThickness="1,0,0,0"
            Padding="10,5"
            Margin="0,15,5,15"
            Visibility="Hidden"
            Opacity="0"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WidthConverter}, ConverterParameter=0.25}">

        <Border.RenderTransform>
            <TranslateTransform x:Name="PanelTransform" X="100"/>
        </Border.RenderTransform>

        <Grid>
            <Grid x:Name="PanelContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Border Grid.Column="0" Grid.Row="0"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrongStrokeColorDisabledBrush}"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            Padding="8,7"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0"
                               Grid.Row="0"
                               Text="{Binding FileViewer.SelectedFiles.Count, StringFormat='Выбрано файлов: {0}'}"/>

                            <TextBlock Grid.Column="0"
                               Grid.Row="1"
                               Text="{Binding FileViewer.SelectedFilesSize, Converter={StaticResource SizeConverter}, StringFormat='Размер выбранных файлов: {0}'}"/>

                            <Button Grid.Column="1"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Margin="5,0,0,0"
                            Content="&#xE89F;"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="20"
                            HorizontalAlignment="Right"
                            Template="{StaticResource HidePanelButton}"
                            Command="{Binding FileViewer.CloseOpenPanelCommand}"/>
                        </Grid>
                    </Border>

                    <Rectangle x:Name="selectionIndicator"
                               Width="3"
                               Height="20"
                               RadiusX="1.5" RadiusY="1.5"
                               Fill="{DynamicResource AccentFillColorDefaultBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,5">
                    <ItemsControl ItemsSource="{Binding TagManager.SharedTagsForSelection}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="PanelBorder"
                                        Height="30"
                                        Width="Auto"
                                        MaxWidth="150"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="7,5,3,5"
                                        Margin="3,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}"/>

                                        <Button Grid.Column="1"
                                                Content="&#xE711;" 
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="Открепить тег от всех выбранных файлов"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.FileViewer.DetachTagFromFileCommand}"
                                                CommandParameter="{Binding Id}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Быстрое добавление тега"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="AddTextBox"
                             FontSize="14"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Padding="3,0,0,0"
                             Margin="0,5"/>

                            <TextBlock Text="Введите название тега"
                               FontSize="14"
                               Padding="5,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AddTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="1"
                            Content="&#xE710;"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            Height="{Binding ActualHeight, ElementName=AddTextBox}"
                            Margin="5,0,5,0"
                            ToolTip="Добавить тег ко всем выбранным файлам"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding FileViewer.IsPanelOpen}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="ShowAnimation">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                    </ObjectAnimationUsingKeyFrames>

                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     To="0" Duration="0:0:0.3">
                                        <DoubleAnimation.EasingFunction>
                                            <CircleEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>

                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard x:Name="HideAnimation">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     To="100"
                                                     Duration="0:0:0.3">
                                        <DoubleAnimation.EasingFunction>
                                            <CircleEase EasingMode="EaseIn"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>

                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="0" Duration="0:0:0.2"/>

                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:0.3">
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Hidden}"/>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</UserControl>

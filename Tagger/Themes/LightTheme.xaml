<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Window-->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#F3F3F3"/>
    
    <!--Window Button-->
    <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="WindowButtonPressedBrush" Color="#CCCCCC"/>
    
    <!--Quick Access List-->
    <SolidColorBrush x:Key="BorderBackgroundHoverBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="BorderBorderBrushHoverBrush" Color="#1F000000"/>

    <SolidColorBrush x:Key="BorderBackgroundSelectedBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="BorderBorderBrushSelectedBrush" Color="#26000000"/>

    <!--Right Tag Panel-->
    <SolidColorBrush x:Key="RightTagPanelBackgroundBrush" Color="#B3F3F4F6"/>
    <SolidColorBrush x:Key="RightTagPanelBorderBrush" Color="#26000000"/>
</ResourceDictionary>
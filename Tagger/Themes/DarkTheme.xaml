<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Window-->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#202020"/>
    
    <!--Window Button-->
    <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="#2d2d2d"/>
    <SolidColorBrush x:Key="WindowButtonPressedBrush" Color="#3a3a3a"/>
    
    <!--Quick Access List-->
    <SolidColorBrush x:Key="BorderBackgroundHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="BorderBorderBrushHoverBrush" Color="#26FFFFFF"/>

    <SolidColorBrush x:Key="BorderBackgroundSelectedBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="BorderBorderBrushSelectedBrush" Color="#33FFFFFF"/>
    
    <!--Right Tag Panel-->
    <SolidColorBrush x:Key="RightTagPanelBackgroundBrush" Color="#99282C31"/>
    <SolidColorBrush x:Key="RightTagPanelBorderBrush" Color="#55FFFFFF"/>

    <SolidColorBrush x:Key="RightTagPanelInfoBackgroundBrush" Color="#99282C31"/>
</ResourceDictionary>